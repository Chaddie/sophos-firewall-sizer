# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Public app URL (used for vanity links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (wireless site plan uploads). Create a store in the Vercel
# dashboard (Storage -> Blob) and run `vercel env pull` to populate this.
# If unset, site plan uploads fall back to inline storage (fine for local/demo use).
BLOB_READ_WRITE_TOKEN=

# Seed script (optional)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Account Manager
SEED_SALES_ENGINEER_EMAIL=se@example.com
SEED_SALES_ENGINEER_PASSWORD=changeme123
SEED_SALES_ENGINEER_NAME=Sales Engineer
