# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Local email/password login (default on). Set to false once SSO is mandatory.
AUTH_ALLOW_CREDENTIALS=true

# --- SSO (optional; leave unset until an IdP is ready) ---
# Microsoft Entra ID — callback: {AUTH_URL}/api/auth/callback/microsoft-entra-id
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0

# Generic OIDC (Okta, Ping, Auth0, Google Workspace, etc.)
# Callback: {AUTH_URL}/api/auth/callback/oidc
# AUTH_OIDC_ID=
# AUTH_OIDC_SECRET=
# AUTH_OIDC_ISSUER=https://your-idp.example.com
# AUTH_OIDC_NAME=Okta

# Restrict SSO to email domains (comma-separated). Empty = allow any domain.
# AUTH_SSO_ALLOWED_DOMAINS=sophos.com,partner.example.com

# Role for first-time SSO users (account_manager | sales_engineer)
# AUTH_SSO_DEFAULT_ROLE=account_manager

# Emails that get sales_engineer on first SSO login (comma-separated)
# AUTH_SSO_SE_EMAILS=se1@sophos.com,se2@sophos.com

# --- Partner portal (/partner) magic links ---
# Optional domain allowlist for partner sign-in (empty = any)
# AUTH_PARTNER_ALLOWED_DOMAINS=partnerco.com,var.com

# Resend email delivery (without these, magic links / password resets are shown in the UI)
# RESEND_API_KEY=
# EMAIL_FROM=Hardware Sizing <onboarding@resend.dev>

# Passkeys use NEXT_PUBLIC_APP_URL (or VERCEL_URL) for WebAuthn rpID/origin.

# Public app URL (used for vanity links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (wireless site plan uploads). Create a store in the Vercel
# dashboard (Storage -> Blob) and run `vercel env pull` to populate this.
# If unset, site plan uploads fall back to inline storage (fine for local/demo use).
BLOB_READ_WRITE_TOKEN=

# Seed script (optional)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Account Manager
SEED_SALES_ENGINEER_EMAIL=se@example.com
SEED_SALES_ENGINEER_PASSWORD=changeme123
SEED_SALES_ENGINEER_NAME=Sales Engineer
